author = {Emre Selcuk and Onur Varol and Gul Gunaydin and Zeynep Deniz Ozden and Turan Deniz Ergun},
title ={From Bias to Brevity: Balancing Coder Bias and Team Size in Thin-Slice and Full-Length Observations of Couple Interactions},
journal = {Journal of Social and Personal Relationships},
volume = {0},
